{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NTA stable-key physical-tier catalog",
  "type": "object",
  "required": [
    "schema",
    "tier",
    "format",
    "namespace",
    "page_tokens",
    "layer_count",
    "components",
    "entries"
  ],
  "properties": {
    "schema": {"const": 2},
    "tier": {"enum": ["nvme", "cxl_dax"]},
    "format": {"const": "typed-components-v1"},
    "namespace": {"type": "string", "minLength": 1, "maxLength": 1024},
    "page_tokens": {"type": "integer", "minimum": 1},
    "layer_count": {"type": "integer", "minimum": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    },
    "alignment_bytes": {"type": "integer", "minimum": 1},
    "window_bytes": {"type": "integer", "minimum": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["storage_key", "ordinal", "layer", "components"],
        "properties": {
          "storage_key": {"type": "string", "minLength": 1, "maxLength": 4096},
          "ordinal": {"type": "integer", "minimum": 0},
          "layer": {"type": "integer", "minimum": 0},
          "components": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "additionalProperties": {"$ref": "#/$defs/extent"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "extent": {
      "type": "object",
      "required": ["offset", "bytes"],
      "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
